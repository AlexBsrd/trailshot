# Prod secrets — copy to .env before `docker compose --profile prod up`.
# .env is gitignored. Compose interpolates these into the api service.

# REQUIRED (the API refuses to boot in prod without non-default values)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Optional
ADMIN_USERNAME=admin

# Email (leave blank → download links are logged to console instead of sent)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@trailshot.fr
